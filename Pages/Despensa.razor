@code {
    private List<Producto> ProductosDespensa = new();
    private List<Categoria> Categorias = new();

    private bool MostrarCamara = false;
    private bool MostrarModal = false;

    private string NuevoCodigo = string.Empty;
    private string NuevoNombre = string.Empty;
    private string NuevaMarca = string.Empty;
    private string CategoriaSeleccionadaId = string.Empty;
    private decimal NuevoPrecio = 0m;
    private int NuevaCantidad = 1;

    private DotNetObjectReference<Despensa>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        Categorias = await Storage.ObtenerCategoriasAsync();
        ProductosDespensa = await Storage.ObtenerProductosAsync();
        dotNetHelper = DotNetObjectReference.Create(this);

        if (Categorias.Any())
        {
            CategoriaSeleccionadaId = Categorias.First().Id;
        }
    }

    private bool EsCodigoValido(string codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return false;
        var len = codigo.Trim().Length;
        return len == 13 || len == 12 || len == 8; // EAN-13, UPC-A (12) y EAN-8
    }

    private async Task AjustarStock(Producto prod, int cambio)
    {
        prod.CantidadEnStock = Math.Max(0, prod.CantidadEnStock + cambio);
        await Storage.GuardarProductoAsync(prod);
    }

    private async Task EliminarProducto(Producto prod)
    {
        ProductosDespensa.Remove(prod);
        await Storage.EliminarProductoAsync(prod.Id);
    }

    private async Task SugerirAgregarALaLista(Producto prod)
    {
        var lista = await Storage.ObtenerListaActualAsync();
        if (!lista.Any(i => i.ProductoId == prod.Id))
        {
            lista.Add(new ItemLista
            {
                ProductoId = prod.Id,
                CantidadPlaneada = 1,
                PrecioEstimado = prod.UltimoPrecio
            });
            await Storage.GuardarListaActualAsync(lista);
        }
        Nav.NavigateTo("/crear-lista");
    }

    private void AbrirModalNuevo()
    {
        NuevoCodigo = string.Empty;
        NuevoNombre = string.Empty;
        NuevaMarca = string.Empty;
        NuevoPrecio = 0m;
        NuevaCantidad = 1;
        MostrarModal = true;
    }

    private void CerrarModal() => MostrarModal = false;

    private async Task ReintentarEscaneo()
    {
        CerrarModal();
        await AbrirEscaner();
    }

    private async Task GuardarProductoDespensa()
    {
        if (string.IsNullOrWhiteSpace(NuevoNombre)) return;

        var prod = ProductosDespensa.FirstOrDefault(p => p.CodigoBarras == NuevoCodigo && !string.IsNullOrEmpty(NuevoCodigo));

        if (prod == null)
        {
            prod = new Producto
            {
                Id = Guid.NewGuid().ToString(),
                Nombre = NuevoNombre.Trim(),
                Marca = NuevaMarca.Trim(),
                CodigoBarras = NuevoCodigo.Trim(),
                CategoriaId = CategoriaSeleccionadaId,
                UltimoPrecio = NuevoPrecio,
                CantidadEnStock = NuevaCantidad
            };
            ProductosDespensa.Add(prod);
        }
        else
        {
            prod.CantidadEnStock += NuevaCantidad;
            if (NuevoPrecio > 0) prod.UltimoPrecio = NuevoPrecio;
        }

        await Storage.GuardarProductoAsync(prod);
        CerrarModal();
    }

    private async Task AbrirEscaner()
    {
        MostrarCamara = true;
        await Task.Delay(100);
        await JS.InvokeVoidAsync("superKScanner.iniciarEscaner", dotNetHelper);
    }

    private async Task CerrarCamara()
    {
        MostrarCamara = false;
        try { await JS.InvokeVoidAsync("superKScanner.detenerEscaner"); } catch { }
    }

    [JSInvokable]
    public async Task OnCodigoEscaneado(string codigo)
    {
        MostrarCamara = false;
        var codigoLimpio = codigo?.Trim() ?? string.Empty;

        var prod = ProductosDespensa.FirstOrDefault(p => p.CodigoBarras == codigoLimpio);

        if (prod != null)
        {
            prod.CantidadEnStock++;
            await Storage.GuardarProductoAsync(prod);
        }
        else
        {
            NuevoCodigo = codigoLimpio;
            NuevoNombre = string.Empty;
            NuevaMarca = string.Empty;
            NuevoPrecio = 0m;
            NuevaCantidad = 1;
            MostrarModal = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => dotNetHelper?.Dispose();
}