@page "/despensa"
@inject StorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="sk-pantry-container">

    <!-- Encabezado -->
    <header class="sk-pantry-header">
        <button class="sk-btn-back" @onclick='() => Nav.NavigateTo("/")'>← Inicio</button>
        <div class="sk-header-title">
            <h2>🥫 Mi Despensa</h2>
            <p>Inventario de casa y control de consumos</p>
        </div>
    </header>

    <!-- Acciones Rápidas -->
    <div class="sk-pantry-actions">
        <button class="sk-btn-primary" @onclick="AbrirEscaner">
            <span>📷</span> Escanear Producto
        </button>
        <button class="sk-btn-secondary" @onclick="AbrirModalNuevo">
            <span>➕</span> Registro Manual
        </button>
    </div>

    <!-- Lista de Inventario -->
    <div class="sk-pantry-card">
        <div class="sk-card-title-row">
            <h3>Productos en Casa (@ProductosDespensa.Count)</h3>
        </div>

        @if (!ProductosDespensa.Any())
        {
            <div class="sk-empty-state">
                <span style="font-size: 2.5rem;">🥫</span>
                <p>Tu despensa está vacía.</p>
                <small>Escanea empaques o agrega manualmente para empezar el control.</small>
            </div>
        }
        else
        {
            <div class="sk-pantry-list">
                @foreach (var prod in ProductosDespensa)
                {
                    <div class="sk-pantry-item @(prod.CantidadEnStock <= 0 ? "agotado" : "")">
                        <div class="sk-item-info">
                            <span class="sk-item-name">@prod.Nombre</span>
                            <span class="sk-item-meta">
                                @(!string.IsNullOrEmpty(prod.Marca) ? prod.Marca + " • " : "")
                                Precio: $@prod.UltimoPrecio.ToString("F2")
                            </span>

                            <!-- Punto de Control: Código de Barras e indicador de dígitos -->
                            @if (!string.IsNullOrWhiteSpace(prod.CodigoBarras))
                            {
                                <span class="sk-item-code">
                                    🏷️ @prod.CodigoBarras 
                                    <small class="sk-digit-badge">(@prod.CodigoBarras.Length dgt)</small>
                                </span>
                            }
                            else
                            {
                                <span class="sk-item-code-none">Sin código asignado</span>
                            }

                            @if (prod.CantidadEnStock <= 0)
                            {
                                <span class="sk-badge-agotado">⚠️ Agotado</span>
                            }
                        </div>

                        <div class="sk-item-controls">
                            <button class="sk-btn-qty" @onclick="() => AjustarStock(prod, -1)">-</button>
                            <span class="sk-qty-count">@prod.CantidadEnStock</span>
                            <button class="sk-btn-qty" @onclick="() => AjustarStock(prod, 1)">+</button>

                            @if (prod.CantidadEnStock <= 0)
                            {
                                <button class="sk-btn-add-list" @onclick="() => SugerirAgregarALaLista(prod)" title="Agregar a la lista del súper">
                                    🛒
                                </button>
                            }

                            <button class="sk-btn-delete" @onclick="() => EliminarProducto(prod)" title="Eliminar producto">
                                🗑️
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Modal Escáner -->
@if (MostrarCamara)
{
    <div class="sk-modal-overlay">
        <div class="sk-modal-card" style="text-align: center;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h3 style="color:#0284c7; font-size:1rem; font-weight:bold;">Escanear Código</h3>
                <button @onclick="CerrarCamara" class="sk-btn-text-danger">✕ Cancelar</button>
            </div>
            <div id="reader" style="width: 100%; max-width: 400px; margin: 0 auto; min-height: 250px;"></div>
            <p style="font-size: 0.75rem; color: #64748b; margin-top: 12px;">
                Centra el código de barras GS1 (EAN-13 o EAN-8) frente a la cámara.
            </p>
        </div>
    </div>
}

<!-- Modal Alta / Confirmación de Producto -->
@if (MostrarModal)
{
    <div class="sk-modal-overlay">
        <div class="sk-modal-card">
            <h3 style="color:#0284c7; font-size:1.1rem; margin-bottom:12px; font-weight:bold;">
                @(string.IsNullOrEmpty(NuevoCodigo) ? "Agregar a Despensa" : "Validar Código Escaneado")
            </h3>

            @if (!string.IsNullOrEmpty(NuevoCodigo))
            {
                <div class="sk-code-badge @(EsCodigoValido(NuevoCodigo) ? "valido" : "alerta")">
                    <span>Código: <strong>@NuevoCodigo</strong> (@NuevoCodigo.Length dígitos)</span>
                    @if (!EsCodigoValido(NuevoCodigo))
                    {
                        <div style="font-size: 0.72rem; margin-top: 4px; color: #b91c1c;">
                            ⚠️ El código no parece ser EAN-13, UPC-A (12) ni EAN-8 estándar.
                        </div>
                    }
                </div>
            }

            <div class="sk-form-group">
                <label class="sk-label">Nombre del Producto</label>
                <input type="text" @bind="NuevoNombre" class="sk-input" placeholder="Ej. Leche Entera 1L" />
            </div>

            <div class="sk-form-group">
                <label class="sk-label">Marca (Opcional)</label>
                <input type="text" @bind="NuevaMarca" class="sk-input" placeholder="Ej. Alpura" />
            </div>

            <div class="sk-form-group">
                <label class="sk-label">Categoría</label>
                <select @bind="CategoriaSeleccionadaId" class="sk-select">
                    @foreach (var cat in Categorias)
                    {
                        <option value="@cat.Id">@cat.Icono @cat.Nombre</option>
                    }
                </select>
            </div>

            <div class="sk-grid-2 sk-form-group">
                <div>
                    <label class="sk-label">Precio ($)</label>
                    <input type="number" step="0.5" @bind="NuevoPrecio" class="sk-input" placeholder="0.00" />
                </div>
                <div>
                    <label class="sk-label">Cantidad en Casa</label>
                    <input type="number" @bind="NuevaCantidad" class="sk-input" />
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
                @if (!string.IsNullOrEmpty(NuevoCodigo))
                {
                    <button @onclick="ReintentarEscaneo" class="sk-btn-text-danger" style="font-size:0.8rem;">
                        🔄 Re-escanear
                    </button>
                }
                <div style="display:flex; gap:8px; margin-left:auto;">
                    <button @onclick="CerrarModal" class="sk-btn-secondary">Cancelar</button>
                    <button @onclick="GuardarProductoDespensa" class="sk-btn-primary" style="background:#0284c7;">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

