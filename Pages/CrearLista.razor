@code {
    private List<ItemLista> ItemsLista = new();
    private List<Producto> ProductosRegistrados = new();
    private List<Categoria> ListaCategorias = new();

    private bool MostrarModal = false;
    private bool MostrarCrearCategoria = false;

    private string ProductoSeleccionadoId = string.Empty;
    private string NuevoNombreTemp = string.Empty;
    private string NuevaMarcaTemp = string.Empty;
    private string CategoriaSeleccionadaId = string.Empty;
    private string NuevaCategoriaNombre = string.Empty;

    private decimal NuevoPrecioEst = 0m;
    private int NuevaCantidad = 1;

    private decimal TotalEstimado => ItemsLista.Sum(i => i.CantidadPlaneada * i.PrecioEstimado);

    protected override async Task OnInitializedAsync()
    {
        ProductosRegistrados = await Storage.ObtenerProductosAsync();
        ItemsLista = await Storage.ObtenerListaActualAsync();
        ListaCategorias = await Storage.ObtenerCategoriasAsync();
    }

    private async Task GuardarCambios()
    {
        await Storage.GuardarListaActualAsync(ItemsLista);
    }

    private async Task CargarAgotadosDespensa()
    {
        var agotados = ProductosRegistrados.Where(p => p.CantidadEnStock <= 0).ToList();
        bool huboCambios = false;

        foreach (var prod in agotados)
        {
            if (!ItemsLista.Any(i => i.ProductoId == prod.Id))
            {
                ItemsLista.Add(new ItemLista
                {
                    ProductoId = prod.Id,
                    CantidadPlaneada = 1,
                    PrecioEstimado = prod.UltimoPrecio,
                    Comprado = false
                });
                huboCambios = true;
            }
        }

        if (huboCambios) await GuardarCambios();
    }

    private async Task AjustarCantidad(ItemLista item, int cambio)
    {
        item.CantidadPlaneada = Math.Max(1, item.CantidadPlaneada + cambio);
        await GuardarCambios();
    }

    private async Task QuitarDeLista(ItemLista item)
    {
        ItemsLista.Remove(item);
        await GuardarCambios();
    }

    private async Task VaciarLista()
    {
        ItemsLista.Clear();
        await GuardarCambios();
    }

    private void AbrirModalAgregar()
    {
        ProductoSeleccionadoId = string.Empty;
        NuevoNombreTemp = string.Empty;
        NuevaMarcaTemp = string.Empty;
        CategoriaSeleccionadaId = string.Empty;
        NuevaCategoriaNombre = string.Empty;
        MostrarCrearCategoria = false;
        NuevoPrecioEst = 0m;
        NuevaCantidad = 1;
        MostrarModal = true;
    }

    private void CerrarModal() => MostrarModal = false;

    private void ToggleCrearCategoria() => MostrarCrearCategoria = !MostrarCrearCategoria;

    private async Task GuardarNuevaCategoria()
    {
        if (string.IsNullOrWhiteSpace(NuevaCategoriaNombre)) return;

        var nuevaCat = new Categoria
        {
            Nombre = NuevaCategoriaNombre.Trim()
        };

        await Storage.GuardarCategoriaAsync(nuevaCat);
        ListaCategorias = await Storage.ObtenerCategoriasAsync();
        CategoriaSeleccionadaId = nuevaCat.Id;
        NuevaCategoriaNombre = string.Empty;
        MostrarCrearCategoria = false;
    }

    private async Task AgregarItemALaLista()
    {
        string? targetProductoId = null;

        // Si es un producto totalmente nuevo, lo registramos en el catálogo de productos
        if (string.IsNullOrEmpty(ProductoSeleccionadoId))
        {
            if (string.IsNullOrWhiteSpace(NuevoNombreTemp)) return;

            var nuevoProducto = new Producto
            {
                Nombre = NuevoNombreTemp.Trim(),
                Marca = NuevaMarcaTemp.Trim(),
                CategoriaId = CategoriaSeleccionadaId,
                UltimoPrecio = NuevoPrecioEst,
                CantidadEnStock = 0,
                CodigoBarras = string.Empty // Se asociará posteriormente al escanear en "Hacer el Súper"
            };

            await Storage.GuardarProductoAsync(nuevoProducto);
            ProductosRegistrados = await Storage.ObtenerProductosAsync();
            targetProductoId = nuevoProducto.Id;
        }
        else

        {
            targetProductoId = ProductoSeleccionadoId;
        }

        var prodRef = ProductosRegistrados.FirstOrDefault(p => p.Id == targetProductoId);

        var item = new ItemLista
        {
            ProductoId = targetProductoId,
            CantidadPlaneada = NuevaCantidad,
            PrecioEstimado = NuevoPrecioEst > 0 ? NuevoPrecioEst : (prodRef?.UltimoPrecio ?? 0m),
            Comprado = false
        };

        ItemsLista.Add(item);
        await GuardarCambios();
        CerrarModal();
    }
}