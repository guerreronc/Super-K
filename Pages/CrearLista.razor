@page "/crear-lista"
@inject StorageService Storage
@inject NavigationManager Nav

<div class="sk-list-container">

    <!-- Encabezado -->
    <header class="sk-list-header">
        <div class="sk-nav-buttons">
            <button class="sk-btn-back" @onclick='() => Nav.NavigateTo("/")'>🏠 Inicio</button>
            <button class="sk-btn-back" @onclick='() => Nav.NavigateTo("/despensa")'>📦 Despensa</button>
        </div>
        <div class="sk-header-title">
            <h2>🛒 Lista del Súper</h2>
            <p>Planeación de compras y presupuesto</p>
        </div>
    </header>

    <!-- Acciones Rápidas -->
    <div class="sk-list-actions">
        <button class="sk-btn-accent" @onclick="CargarAgotadosDespensa">
            ⚡ Cargar Agotados
        </button>
        <button class="sk-btn-secondary" @onclick="AbrirModalAgregar">
            ➕ Agregar Item
        </button>
    </div>

    <!-- Contenedor Principal de la Lista -->
    <div class="sk-list-card">
        <div class="sk-card-title-row">
            <h3>Artículos a comprar (@ItemsLista.Count)</h3>
            @if (ItemsLista.Any())
            {
                <button class="sk-btn-text-danger" @onclick="VaciarLista">Vaciar todo</button>
            }
        </div>

        @if (!ItemsLista.Any())
        {
            <div class="sk-empty-state">
                <span style="font-size: 2.5rem;">🛒</span>
                <p>Tu lista está vacía.</p>
                <small>Presiona "Cargar Agotados" para traer lo que falta en tu despensa.</small>
            </div>
        }
        else
        {
            <div class="sk-items-wrapper">
                @foreach (var item in ItemsLista)
                {
                    var prod = ProductosRegistrados.FirstOrDefault(p => p.Id == item.ProductoId);
                    var nombre = prod?.Nombre ?? item.NombreTemporal ?? "Producto sin nombre";
                    var marca = prod?.Marca ?? "";
                    var subtotal = item.CantidadPlaneada * item.PrecioEstimado;

                    <div class="sk-list-item">
                        <div class="sk-item-details">
                            <span class="sk-item-title">@nombre</span>
                            <span class="sk-item-sub">
                                @(!string.IsNullOrEmpty(marca) ? marca + " • " : "")$@item.PrecioEstimado.ToString("F2") c/u
                            </span>
                            <span class="sk-item-subtotal">Subtotal: $@subtotal.ToString("F2")</span>
                        </div>

                        <div class="sk-item-controls">
                            <button class="sk-btn-qty" @onclick="() => AjustarCantidad(item, -1)">-</button>
                            <span class="sk-qty-count">@item.CantidadPlaneada</span>
                            <button class="sk-btn-qty" @onclick="() => AjustarCantidad(item, 1)">+</button>
                            
                            <button class="sk-btn-delete" @onclick="() => QuitarDeLista(item)" title="Quitar de lista">
                                🗑️
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Resumen de Presupuesto -->
            <div class="sk-summary-box">
                <div class="sk-summary-row">
                    <span>Total Estimado:</span>
                    <strong class="sk-total-price">$@TotalEstimado.ToString("F2")</strong>
                </div>

                <button class="sk-btn-go-super" @onclick='() => Nav.NavigateTo("/hacer-super")'>
                    🛒 Ir a Hacer el Súper
                </button>
            </div>
        }
    </div>

</div>

<!-- Modal Agregar Item / Dar de Alta Producto -->
@if (MostrarModal)
{
    <div class="sk-modal-overlay">
        <div class="sk-modal-card">
            <h3 style="color:#0284c7; font-size:1.1rem; margin-bottom:12px; font-weight:bold;">
                Agregar a la Lista
            </h3>

            <!-- Selector de productos existentes -->
            <div class="sk-form-group">
                <label class="sk-label">Seleccionar de Despensa</label>
                <select @bind="ProductoSeleccionadoId" class="sk-select">
                    <option value="">-- Registrar Nuevo Producto --</option>
                    @foreach (var p in ProductosRegistrados)
                    {
                        <option value="@p.Id">@p.Nombre @(!string.IsNullOrEmpty(p.Marca) ? $"({p.Marca})" : "")</option>
                    }
                </select>
            </div>

            <!-- Formulario para Producto Nuevo -->
            @if (string.IsNullOrEmpty(ProductoSeleccionadoId))
            {
                <div class="sk-form-group">
                    <label class="sk-label">Nombre del Producto *</label>
                    <input type="text" @bind="NuevoNombreTemp" class="sk-input" placeholder="Ej. Avena Integral 500g" />
                </div>

                <div class="sk-form-group">
                    <label class="sk-label">Marca</label>
                    <input type="text" @bind="NuevaMarcaTemp" class="sk-input" placeholder="Ej. GranVita" />
                </div>

                <div class="sk-form-group">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <label class="sk-label" style="margin:0;">Categoría</label>
                        <button class="sk-btn-link" @onclick="ToggleCrearCategoria">
                            @(MostrarCrearCategoria ? "✕ Cancelar" : "➕ Nueva Categoría")
                        </button>
                    </div>

                    @if (MostrarCrearCategoria)
                    {
                        <div class="sk-inline-create">
                            <input type="text" @bind="NuevaCategoriaNombre" class="sk-input" placeholder="Nombre nueva categoría" />
                            <button class="sk-btn-primary" @onclick="GuardarNuevaCategoria">Guardar</button>
                        </div>
                    }
                    else
                    {
                        <select @bind="CategoriaSeleccionadaId" class="sk-select">
                            <option value="">-- Sin Categoría --</option>
                            @foreach (var cat in ListaCategorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    }
                </div>
            }

            <div class="sk-grid-2 sk-form-group">
                <div>
                    <label class="sk-label">Precio Est. ($)</label>
                    <input type="number" step="0.5" @bind="NuevoPrecioEst" class="sk-input" placeholder="0.00 (Opcional)" />
                </div>
                <div>
                    <label class="sk-label">Cantidad</label>
                    <input type="number" @bind="NuevaCantidad" class="sk-input" min="1" />
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
                <button @onclick="CerrarModal" class="sk-btn-secondary">Cancelar</button>
                <button @onclick="AgregarItemALaLista" class="sk-btn-primary">Agregar a Lista</button>
            </div>
        </div>
    </div>
}

