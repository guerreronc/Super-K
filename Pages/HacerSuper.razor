    .sk-qty-label { font-size: 0.6rem; color: #0369a1; font-weight: 800; letter-spacing: 0.5px; }
    .sk-qty-val { font-size: 1rem; color: #0284c7; font-weight: 900; line-height: 1.1; }
    .sk-qty-val small { font-size: 0.65rem; font-weight: 700; color: #0369a1; }

    .sk-price-input-box { display: flex; flex-direction: column; align-items: flex-end; width: 75px; }
    .sk-price-input-box label { font-size: 0.65rem; color: #475569; font-weight: 700; }
    .sk-input-price { width: 100%; text-align: right; padding: 5px; border: 1px solid #94a3b8; border-radius: 6px; font-weight: 800; font-size: 0.9rem; color: #0f172a; }

    .sk-finish-box { margin-top: 16px; }
    .sk-btn-success { width: 100%; background: #16a34a; color: white; border: none; padding: 14px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 10px rgba(22, 163, 74, 0.25); }

    .sk-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); display: flex; align-items: center; justify-content: center; padding: 16px; z-index: 1000; backdrop-filter: blur(2px); }
    .sk-modal-card { background: #ffffff !important; color: #0f172a !important; width: 100%; max-width: 400px; border-radius: 16px; padding: 20px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); }
    
    .sk-modal-header-clean { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .sk-modal-header-clean h3 { margin: 0; font-size: 1.1rem; color: #0369a1; font-weight: 800; }
    .sk-code-badge { background: #f1f5f9; font-size: 0.75rem; font-weight: 700; padding: 4px 8px; border-radius: 6px; color: #334155; border: 1px solid #cbd5e1; }

    .sk-modal-product-box { background: #f0f9ff; border: 1px solid #bae6fd; padding: 12px; border-radius: 10px; margin-bottom: 14px; }
    .sk-modal-product-title { font-weight: 800; color: #0369a1; font-size: 1.05rem; margin: 0 0 4px 0; }
    .sk-modal-product-sub { font-size: 0.8rem; color: #0284c7; margin: 0; }

    .sk-modal-form-stack { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
    .sk-modal-label { display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px; }
    .sk-modal-input { width: 100%; padding: 10px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 1.1rem; font-weight: 800; color: #0f172a; box-sizing: border-box; }
    .sk-modal-input.highlight-price { color: #15803d; border-color: #86efac; }

    .sk-subtotal-box { background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px; border-radius: 8px; text-align: center; }
    .sk-subtotal-label { font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; }
    .sk-subtotal-amount { font-size: 1.2rem; font-weight: 900; color: #0f172a; }

    .sk-modal-actions { display: flex; gap: 10px; }
    .sk-modal-actions button { flex: 1; padding: 10px; font-size: 0.9rem; }

    .sk-link-box { background: #fefce8; border: 1px solid #fef08a; padding: 10px; border-radius: 8px; }
    .sk-form-group { margin-bottom: 12px; }
    .sk-label { display: block; font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 4px; }
    .sk-input, .sk-select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; }
    .sk-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .sk-btn-primary { background: #0284c7; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .sk-btn-secondary { background: white; border: 1px solid #cbd5e1; color: #334155; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .sk-btn-accent { background: #0284c7; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .sk-btn-outline { background: white; border: 1px solid #cbd5e1; color: #475569; padding: 8px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .sk-btn-text-danger { background: none; border: none; color: #ef4444; font-weight: 700; cursor: pointer; }
    .sk-empty-state { text-align: center; padding: 20px; color: #64748b; }

    @@media (min-width: 600px) { .sk-super-container { max-width: 640px; } }
</style>

@code {
    private List<ItemLista> ItemsLista = new();
    private List<Producto> ProductosRegistrados = new();
    private List<Categoria> ListaCategorias = new();

    private string CodigoEscaner = string.Empty;
    private string CodigoEscaneado = string.Empty;

    // Estados de Modales
    private bool MostrarModalConfirmarPrecio = false;
    private bool MostrarModalEdicionCompleta = false;
    private bool buscandoEnWeb = false;

    private ItemLista? itemSeleccionado = null;
    private string NombreProductoRapido = string.Empty;

    // Variables de Modal Confirmar
    private int cantidadAComprar = 1;
    private decimal precioTemporal = 0m;

    // Campos de Formulario Edición
    private string ProductoSeleccionadoVincularId = string.Empty;
    private string EditNombre = string.Empty;
    private string EditMarca = string.Empty;
    private string EditCategoriaId = string.Empty;
    private int EditCantidad = 1;
    private decimal EditPrecioReal = 0m;

    private string? fotoModalUrl;
    private string codigoBusqueda = string.Empty;
    private DotNetObjectReference<HacerSuper>? dotNetHelper;
    private bool MostrarCamara = false;

    private decimal TotalEstimado => ItemsLista.Sum(i => i.CantidadPlaneada * i.PrecioEstimado);
    private decimal TotalReal => ItemsLista.Where(i => i.Comprado).Sum(i => i.CantidadPlaneada * i.PrecioEstimado);
    private HashSet<string> productosNuevosEnSesion = new();
    private IEnumerable<ItemLista> ItemsSinCodigoEnLista => ItemsLista.Where(i =>
    {
        var prod = ProductosRegistrados.FirstOrDefault(p => p.Id == i.ProductoId);
        return prod == null || string.IsNullOrEmpty(prod.CodigoBarras);
    });
    private async Task ToggleConsumoRapido(ItemLista item, bool esConsumo)
    {
        item.EsConsumoRapido = esConsumo;
        await Storage.GuardarListaActualAsync(ItemsLista);
