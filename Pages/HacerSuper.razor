@page "/hacer-super"
@inject StorageService Storage
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Text.Json
@implements IDisposable

<div class="sk-super-container">

    <!-- Encabezado -->
    <header class="sk-super-header">
        <button class="sk-btn-back" @onclick='() => Nav.NavigateTo("/crear-lista")'>⬅️ Volver a Lista</button>
        <div>
            <h2>🛒 Hacer el Súper</h2>
            <p>Pasillo y caja en tiempo real</p>
        </div>
    </header>

    <!-- Resumen de Gasto en Vivo -->
    <div class="sk-live-total-card">
        <div class="sk-total-col">
            <span class="sk-total-label">Estimado</span>
            <span class="sk-total-val">$@TotalEstimado.ToString("F2")</span>
        </div>
        <div class="sk-total-divider"></div>
        <div class="sk-total-col">
            <span class="sk-total-label">Llevas Gastado</span>
            <span class="sk-total-val highlight">$@TotalReal.ToString("F2")</span>
        </div>
    </div>

    <!-- Barra de Escáner y Búsqueda -->
    <div class="sk-scanner-card">
        <div class="sk-scanner-row">
            <button type="button" class="sk-btn-scan-js" @onclick="AbrirEscaner">
                📷 Escáner
            </button>
            <input type="text" 
                @bind="codigoBusqueda" 
                placeholder="Escanea o escribe código..." 
                class="sk-input" />
            <button type="button" class="sk-btn-accent" @onclick="BuscarProducto">
                Buscar
            </button>
        </div>
    </div>

    <!-- Lista de Compras -->
    <div class="sk-super-card">
        <h3>Artículos en Carrito (@ItemsLista.Count(i => i.Comprado) / @ItemsLista.Count)</h3>

        @if (!ItemsLista.Any())
        {
            <div class="sk-empty-state">
                <p>No hay artículos en tu lista planeada.</p>
                <button class="sk-btn-secondary" @onclick='() => Nav.NavigateTo("/crear-lista")'>Armar Lista</button>
            </div>
        }
        else
        {
            <div class="sk-items-list">
                @foreach (var item in ItemsLista)
                {
                    var prod = ProductosRegistrados.FirstOrDefault(p => p.Id == item.ProductoId);
                    var nombre = prod?.Nombre ?? item.NombreTemporal ?? "Sin nombre";
                    var marca = prod?.Marca ?? "";
                    var tieneCodigo = prod != null && !string.IsNullOrEmpty(prod.CodigoBarras);

                    <div class="sk-super-item @(item.Comprado ? "checked" : "")">
                        <input type="checkbox" class="sk-checkbox" checked="@item.Comprado" 
                               @onchange="(e) => ToggleComprado(item, (bool)e.Value!)" />

                        <!-- Información del producto -->
                        <div class="sk-item-info">
                            <span class="sk-item-title">
                                @nombre
                                @if (!tieneCodigo)
                                {
                                    <span class="sk-tag-warning">Sin Código</span>
                                }
                            </span>
                            <span class="sk-item-sub">@(!string.IsNullOrEmpty(marca) ? marca : "Sin marca")</span>
                            
                            <div class="sk-item-actions-row">
                                @if (item.TieneFotoOferta && !string.IsNullOrEmpty(item.FotoOfertaBase64))
                                {
                                    <button type="button" 
                                            @onclick="() => MostrarFoto(item.FotoOfertaBase64)"
                                            class="sk-btn-evidencia-active">
                                        👁️ Ver Foto
                                    </button>
                                    <button type="button" 
                                            @onclick="() => CapturarEvidenciaOferta(item)"
                                            class="sk-btn-action-small">
                                        📷 Cambiar
                                    </button>
                                    <button type="button" 
                                            @onclick="() => BorrarFotoItem(item)"
                                            class="sk-btn-danger-small">
                                        ✕
                                    </button>
                                }
                                else
                                {
                                    <button type="button" 
                                            @onclick="() => CapturarEvidenciaOferta(item)"
                                            class="sk-btn-evidencia">
                                        📷 Evidencia
                                    </button>
                                }

                                @if (prod != null)
                                {
                                    <button class="sk-btn-edit-inline" @onclick="() => AbrirModalEdicionCompleta(item, prod)">
                                        ✏️ Editar
                                    </button>
                                }
                            </div>
                            <!-- NUEVO: Opciones de Consumo Rápido -->
                            <div style="margin-top: 4px;">
                                <label style="font-size: 0.72rem; color: #64748b; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    <input type="checkbox" 
                                        checked="@item.EsConsumoRapido" 
                                        @onchange="(e) => ToggleConsumoRapido(item, (bool)e.Value!)"
                                        style="accent-color: #f59e0b; cursor: pointer;" />
                                    🍿 No guardar en despensa (Consumo rápido)
                                </label>
                            </div>
                        </div>

                        <!-- COLUMNA DE CANTIDAD -->
                        <div class="sk-qty-badge-box">
                            <span class="sk-qty-label">LLEVAS</span>
                            <span class="sk-qty-val">@item.CantidadPlaneada <small>pza</small></span>
                        </div>

                        <!-- Precio Real -->
                        <div class="sk-price-input-box">
                            <label>Precio ($)</label>
                            <input type="number" step="0.5" class="sk-input-price" 
                                   value="@item.PrecioEstimado" 
                                   @onchange="(e) => ActualizarPrecioReal(item, e.Value?.ToString())" />
                        </div>
                    </div>
                }
            </div>

            <div class="sk-finish-box">
                <button class="sk-btn-success" @onclick="FinalizarCompra">
                    ✅ Finalizar Compra y Surtir Despensa
                </button>
            </div>
        }
    </div>

</div>

<!-- MODAL 1: CONFIRMACIÓN RÁPIDA (PRODUCTO YA REGISTRADO Y EN LISTA) -->
@if (MostrarModalConfirmarPrecio && itemSeleccionado != null)
{
    var prodCoincidente = ProductosRegistrados.FirstOrDefault(p => p.Id == itemSeleccionado.ProductoId);
    <div class="sk-modal-overlay">
        <div class="sk-modal-card">
            <div class="sk-modal-header-clean">
                <h3>⚡ Producto en Lista</h3>
                <span class="sk-code-badge">🏷️ @prodCoincidente?.CodigoBarras</span>
            </div>

            <div class="sk-modal-product-box">
                <p class="sk-modal-product-title">@(prodCoincidente?.Nombre ?? itemSeleccionado.NombreTemporal)</p>
                <p class="sk-modal-product-sub">Planeado originalmente: <strong>@itemSeleccionado.CantidadPlaneada pza(s)</strong></p>
            </div>

            <div class="sk-modal-form-stack">
                <div>
                    <label class="sk-modal-label">Piezas a Llevar:</label>
                    <input type="number" 
                           min="1" 
                           @bind="cantidadAComprar" 
                           @bind:event="oninput" 
                           class="sk-modal-input text-center" />
                </div>

                <div>
                    <label class="sk-modal-label">Precio Unitario ($):</label>
                    <input type="number" 
                           step="0.50" 
                           @bind="precioTemporal" 
                           @bind:event="oninput" 
                           class="sk-modal-input text-center highlight-price" />
                </div>

                <div class="sk-subtotal-box">
                    <span class="sk-subtotal-label">Subtotal Calculado:</span>
                    <span class="sk-subtotal-amount">
                        $@((cantidadAComprar * precioTemporal).ToString("F2"))
                    </span>
                </div>
            </div>

            <div class="sk-modal-actions">
                <button type="button" class="sk-btn-outline" @onclick="CerrarModales">Cancelar</button>
                <button type="button" class="sk-btn-accent" @onclick="ConfirmarAgregarAlCarrito">
                    🛒 Agregar al Carrito
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL 2: EDICIÓN / REGISTRO RÁPIDO CON AUTOCOMPLETADO WEB -->
@if (MostrarModalEdicionCompleta)
{
    <div class="sk-modal-overlay">
        <div class="sk-modal-card">
            <div class="sk-modal-header-status">
                <h3>📝 Registrar / Vincular Producto</h3>
                <span class="sk-code-badge">🏷️ @(string.IsNullOrEmpty(CodigoEscaneado) ? "Manual" : CodigoEscaneado)</span>
            </div>

            @if (buscandoEnWeb)
            {
                <div style="text-align:center; padding: 10px; color:#0284c7; font-weight:bold;">
                    🔍 Consultando datos del producto en internet...
                </div>
            }

            @if (ItemsSinCodigoEnLista.Any())
            {
                <div class="sk-form-group sk-link-box">
                    <label class="sk-label">🔗 Vincular a producto sin código de la lista:</label>
                    <select value="@ProductoSeleccionadoVincularId" @onchange="OnSeleccionarVincular" class="sk-select">
                        <option value="">-- Registrar como Nuevo Producto --</option>
                        @foreach (var itemSinCod in ItemsSinCodigoEnLista)
                        {
                            var p = ProductosRegistrados.FirstOrDefault(x => x.Id == itemSinCod.ProductoId);
                            if (p != null)
                            {
                                <option value="@p.Id">@p.Nombre @(!string.IsNullOrEmpty(p.Marca) ? $"({p.Marca})" : "")</option>
                            }
                        }
                    </select>
                </div>
            }

            <div class="sk-form-group">
                <label class="sk-label">Nombre del Producto *</label>
                <input type="text" @bind="EditNombre" class="sk-input" placeholder="Ej. Avena Integral GranVita" />
            </div>

            <div class="sk-form-group">
                <label class="sk-label">Marca</label>
                <input type="text" @bind="EditMarca" class="sk-input" placeholder="Ej. GranVita" />
            </div>

            <div class="sk-form-group">
                <label class="sk-label">Categoría</label>
                <select @bind="EditCategoriaId" class="sk-select">
                    <option value="">-- Sin Categoría --</option>
                    @foreach (var cat in ListaCategorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>

            <div class="sk-grid-2 sk-form-group">
                <div>
                    <label class="sk-label">Cantidad (Pzas)</label>
                    <input type="number" min="1" @bind="EditCantidad" class="sk-input" />
                </div>
                <div>
                    <label class="sk-label">Precio Real ($)</label>
                    <input type="number" step="0.5" @bind="EditPrecioReal" class="sk-input" placeholder="0.00" />
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
                <button @onclick="CerrarModales" class="sk-btn-secondary">Cancelar</button>
                <!-- Botón actualizado sin la palabra "Guardar" -->
                <button @onclick="GuardarYAgregarEdicionCompleta" class="sk-btn-primary">
                    🛒 Agregar al Carrito
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal Escáner -->
@if (MostrarCamara)
{
    <div class="sk-modal-overlay">
        <div class="sk-modal-card" style="text-align: center;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h3 style="color:#0284c7; font-size:1.1rem; font-weight:bold; margin:0;">Escanear Código</h3>
                <button type="button" @onclick="CerrarCamara" class="sk-btn-text-danger">✕ Cancelar</button>
            </div>
            
            <div id="reader" style="width: 100%; max-width: 400px; margin: 0 auto; min-height: 250px;"></div>
            
            <p style="font-size: 0.8rem; color: #475569; margin-top: 12px;">
                Centra el código de barras frente a la cámara.
            </p>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(fotoModalUrl))
{
    <div class="sk-modal-overlay" @onclick="CerrarFotoModal">
        <div class="sk-modal-card" style="max-width:360px; text-align:center;" @onclick:stopPropagation>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h4 style="margin:0; font-size:0.95rem; font-weight:bold; color:#0f172a;">Evidencia de Oferta</h4>
                <button type="button" @onclick="CerrarFotoModal" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:#64748b;">✕</button>
            </div>
            
            <img src="@fotoModalUrl" style="max-height:60vh; width:100%; object-fit:contain; border-radius:8px; border:1px solid #cbd5e1;" alt="Foto Evidencia" />
            
            <button type="button" @onclick="CerrarFotoModal" class="sk-btn-secondary" style="width:100%; margin-top:12px;">
                Cerrar
            </button>
        </div>
    </div>
}

<style>
    .sk-super-container input[type="text"],
    .sk-super-container input[type="number"],
    .sk-super-container select,
    .sk-modal-card input[type="text"],
    .sk-modal-card input[type="number"],
    .sk-modal-card select {
        background-color: #ffffff !important;
        color: #0f172a !important;
        border: 1px solid #94a3b8 !important;
    }

    .sk-super-container { max-width: 520px; margin: 0 auto; padding: 20px 16px; background-color: #f8fafc; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif; }
    .sk-super-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .sk-btn-back { background: white; border: 1px solid #cbd5e1; padding: 8px 12px; border-radius: 10px; font-weight: 600; cursor: pointer; color: #475569; font-size: 0.85rem; }
    .sk-super-header h2 { margin: 0; font-size: 1.3rem; color: #0284c7; font-weight: 800; }
    .sk-super-header p { margin: 0; font-size: 0.78rem; color: #64748b; }

    .sk-live-total-card { background: #0284c7; color: white; border-radius: 16px; padding: 16px; display: flex; align-items: center; justify-content: space-around; margin-bottom: 16px; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25); }
    .sk-total-col { display: flex; flex-direction: column; align-items: center; }
    .sk-total-label { font-size: 0.75rem; text-transform: uppercase; opacity: 0.9; font-weight: 700; }
    .sk-total-val { font-size: 1.3rem; font-weight: 800; }
    .sk-total-val.highlight { color: #fef08a; font-size: 1.5rem; }
    .sk-total-divider { width: 1px; height: 36px; background: rgba(255,255,255,0.3); }

    .sk-scanner-card { background: white; border-radius: 14px; padding: 14px; border: 1px solid #e2e8f0; margin-bottom: 16px; }
    .sk-scanner-row { display: flex; gap: 8px; margin-top: 4px; }

    .sk-btn-scan-js { background: #0f172a; color: white; border: none; padding: 0 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 4px; white-space: nowrap; }
    
    .sk-super-card { background: white; border-radius: 16px; padding: 16px; border: 1px solid #e2e8f0; }
    .sk-super-card h3 { margin: 0 0 14px 0; font-size: 1rem; color: #1e293b; font-weight: 700; }

    .sk-items-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
    .sk-super-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; }
    .sk-super-item.checked { background: #f0fdf4; border-color: #bbf7d0; }
    .sk-checkbox { width: 20px; height: 20px; accent-color: #16a34a; cursor: pointer; }

    .sk-item-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .sk-item-title { font-weight: 700; font-size: 0.88rem; color: #0f172a; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .sk-item-sub { font-size: 0.75rem; color: #64748b; }
    
    .sk-item-actions-row { display: flex; align-items: center; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .sk-btn-edit-inline { background: none; border: none; color: #0284c7; font-size: 0.72rem; font-weight: 700; cursor: pointer; padding: 0; }
    .sk-btn-evidencia { background: #fffbe3; border: 1px solid #fde047; color: #b45309; font-size: 0.7rem; padding: 2px 6px; border-radius: 6px; font-weight: 600; cursor: pointer; }
    .sk-btn-evidencia-active { background: #dcfce7; border: 1px solid #86efac; color: #15803d; font-size: 0.7rem; padding: 2px 6px; border-radius: 6px; font-weight: 700; cursor: pointer; }
    .sk-btn-action-small { background: #f1f5f9; border: 1px solid #cbd5e1; color: #334155; font-size: 0.7rem; padding: 2px 6px; border-radius: 6px; cursor: pointer; }
    .sk-btn-danger-small { background: none; border: none; color: #ef4444; font-size: 0.75rem; font-weight: bold; cursor: pointer; padding: 0 4px; }
    .sk-tag-warning { background: #fef3c7; color: #d97706; font-size: 0.65rem; padding: 2px 6px; border-radius: 6px; font-weight: 700; }

