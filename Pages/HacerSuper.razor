    private void LimpiarFotosTemporales()
    {
        foreach (var item in ItemsLista)
        {
            item.TieneFotoOferta = false;
            item.FotoOfertaBase64 = null;
        }
    }

    private async Task ToggleComprado(ItemLista item, bool comprado)
    {
        item.Comprado = comprado;
        await Storage.GuardarListaActualAsync(ItemsLista);
    }

    private async Task ActualizarPrecioReal(ItemLista item, string? valorTexto)
    {
        if (decimal.TryParse(valorTexto, out decimal nuevoPrecio))
        {
            item.PrecioEstimado = Math.Max(0, nuevoPrecio);
            await Storage.GuardarListaActualAsync(ItemsLista);
        }
    }

    private void CerrarModales()
    {
        MostrarModalConfirmarPrecio = false;
        MostrarModalEdicionCompleta = false;
        buscandoEnWeb = false;
        itemSeleccionado = null;
    }

    private async Task FinalizarCompra()
    {
        var comprados = ItemsLista.Where(i => i.Comprado).ToList();
        if (!comprados.Any()) return;

        foreach (var item in comprados)
        {
            if (string.IsNullOrEmpty(item.ProductoId)) continue;

            var prod = ProductosRegistrados.FirstOrDefault(p => p.Id == item.ProductoId);
            if (prod != null)
            {
                if (!item.EsConsumoRapido)
                {
                    prod.CantidadEnStock += item.CantidadPlaneada;
                    if (item.PrecioEstimado > 0) prod.UltimoPrecio = item.PrecioEstimado;
                    await Storage.GuardarProductoAsync(prod);
                }
                else
                {
                    // Si es consumo rápido y se registró apenas en esta compra, 
                    // lo removemos del catálogo para que no aparezca en la despensa con 0.
                    if (productosNuevosEnSesion.Contains(prod.Id))
                    {
                        await Storage.EliminarProductoAsync(prod.Id);
                    }
                    else
                    {
                        // Si ya existía antes en tu catálogo, conservamos el registro y solo actualizamos precio
                        if (item.PrecioEstimado > 0) prod.UltimoPrecio = item.PrecioEstimado;
                        await Storage.GuardarProductoAsync(prod);
                    }
                }
            }
        }

        ItemsLista = ItemsLista.Where(i => !i.Comprado).ToList();
        LimpiarFotosTemporales();
        await Storage.GuardarListaActualAsync(ItemsLista);
        Nav.NavigateTo("/despensa");
    }
