    private void PrepararModalEdicionCompleta(Producto? productoExistente)
    {
        ProductoSeleccionadoVincularId = string.Empty;

        if (productoExistente != null)
        {
            EditNombre = productoExistente.Nombre;
            EditMarca = productoExistente.Marca;
            EditCategoriaId = productoExistente.CategoriaId;
            EditPrecioReal = productoExistente.UltimoPrecio;
        }
        else
        {
            EditNombre = string.Empty;
            EditMarca = string.Empty;
            EditCategoriaId = string.Empty;
            EditPrecioReal = 0m;
        }

        EditCantidad = 1;
        MostrarModalEdicionCompleta = true;
    }

    private void OnSeleccionarVincular(ChangeEventArgs e)
    {
        ProductoSeleccionadoVincularId = e.Value?.ToString() ?? string.Empty;
        var prod = ProductosRegistrados.FirstOrDefault(p => p.Id == ProductoSeleccionadoVincularId);

        if (prod != null)
        {
            EditNombre = prod.Nombre;
            EditMarca = prod.Marca;
            EditCategoriaId = prod.CategoriaId;
            if (EditPrecioReal == 0) EditPrecioReal = prod.UltimoPrecio;

            var item = ItemsLista.FirstOrDefault(i => i.ProductoId == prod.Id);
            if (item != null) EditCantidad = item.CantidadPlaneada;
        }
    }

    private void AbrirModalEdicionCompleta(ItemLista item, Producto prod)
    {
        CodigoEscaneado = prod.CodigoBarras;
        ProductoSeleccionadoVincularId = prod.Id;

        EditNombre = prod.Nombre;
        EditMarca = prod.Marca;
        EditCategoriaId = prod.CategoriaId;
        EditCantidad = item.CantidadPlaneada;
        EditPrecioReal = item.PrecioEstimado;

        MostrarModalEdicionCompleta = true;
    }

    private async Task GuardarYAgregarEdicionCompleta()
    {
        if (string.IsNullOrWhiteSpace(EditNombre)) return;

        Producto? prodTarget = null;

        if (!string.IsNullOrEmpty(ProductoSeleccionadoVincularId))
        {
            prodTarget = ProductosRegistrados.FirstOrDefault(p => p.Id == ProductoSeleccionadoVincularId);
        }

        if (prodTarget == null)
        {
            prodTarget = new Producto
            {
                Nombre = EditNombre.Trim(),
                Marca = EditMarca.Trim(),
                CategoriaId = EditCategoriaId,
                CodigoBarras = CodigoEscaneado,
                UltimoPrecio = EditPrecioReal
            };
            await Storage.GuardarProductoAsync(prodTarget);
            
            // Guardamos el ID para saber que se creó en esta compra
            productosNuevosEnSesion.Add(prodTarget.Id); 
        }
        else
        {
            prodTarget.Nombre = EditNombre.Trim();
            prodTarget.Marca = EditMarca.Trim();
            prodTarget.CategoriaId = EditCategoriaId;
            if (!string.IsNullOrEmpty(CodigoEscaneado)) prodTarget.CodigoBarras = CodigoEscaneado;
            if (EditPrecioReal > 0) prodTarget.UltimoPrecio = EditPrecioReal;

            await Storage.GuardarProductoAsync(prodTarget);
        }

        ProductosRegistrados = await Storage.ObtenerProductosAsync();

        var itemLista = ItemsLista.FirstOrDefault(i => i.ProductoId == prodTarget.Id);
        if (itemLista != null)
        {
            itemLista.CantidadPlaneada = EditCantidad;
            itemLista.PrecioEstimado = EditPrecioReal;
            itemLista.Comprado = true;
        }
        else
        {
            ItemsLista.Add(new ItemLista
            {
                ProductoId = prodTarget.Id,
                CantidadPlaneada = EditCantidad,
                PrecioEstimado = EditPrecioReal,
                Comprado = true
            });
        }

        await Storage.GuardarListaActualAsync(ItemsLista);
        CerrarModales();
    }

    private async Task CapturarEvidenciaOferta(ItemLista item)
