    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
        ProductosRegistrados = await Storage.ObtenerProductosAsync();
        ListaCategorias = await Storage.ObtenerCategoriasAsync();
        ItemsLista = await Storage.ObtenerListaActualAsync();
    }

    private async Task BuscarProducto()
    {
        if (!string.IsNullOrWhiteSpace(codigoBusqueda))
        {
            await ProcesarCodigoBarras(codigoBusqueda.Trim());
            codigoBusqueda = string.Empty;
        }
    }

    private async Task AbrirEscaner()
    {
        MostrarCamara = true;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("superKScanner.iniciarEscaner", dotNetHelper);
    }

    private async Task CerrarCamara()
    {
        MostrarCamara = false;
        StateHasChanged();
        try 
        { 
            await JS.InvokeVoidAsync("superKScanner.detenerEscaner"); 
        } 
        catch { }
    }

    [JSInvokable]
    public async Task OnCodigoEscaneado(string codigo)
    {
        var codigoLimpio = codigo?.Trim() ?? string.Empty;
        codigoBusqueda = codigoLimpio;
        await CerrarCamara();

        if (!string.IsNullOrEmpty(codigoLimpio))
        {
            await ProcesarCodigoBarras(codigoLimpio);
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }

    private async Task ProcesarCodigoBarras(string codigo)
    {
        CodigoEscaneado = codigo;
        CerrarModales();

        // 1. Buscar en catálogo local registrado
        var productoExistente = ProductosRegistrados.FirstOrDefault(p => p.CodigoBarras == codigo);

        if (productoExistente != null)
        {
            itemSeleccionado = ItemsLista.FirstOrDefault(i => i.ProductoId == productoExistente.Id);

            if (itemSeleccionado != null)
            {
                // CASO A: Existe y está en la lista de compras activa
                cantidadAComprar = itemSeleccionado.CantidadPlaneada > 0 ? itemSeleccionado.CantidadPlaneada : 1;
                precioTemporal = itemSeleccionado.PrecioEstimado > 0 ? itemSeleccionado.PrecioEstimado : productoExistente.UltimoPrecio;
                MostrarModalConfirmarPrecio = true;
                return;
            }

            // Existe en tu BD local pero no en la lista de hoy
            PrepararModalEdicionCompleta(productoExistente);
            return;
        }

        // CASO B: Producto NUEVO (no existe en BD local) -> Consultar Open Food Facts
        buscandoEnWeb = true;
        MostrarModalEdicionCompleta = true;
        StateHasChanged();

        // Cambiar esto:
        // var (nombreWeb, marcaWeb) = await ConsultarOpenFoodFactsAsync(codigo);

        // Por esto:
        var (nombreWeb, marcaWeb) = await ConsultarAPIsWebAsync(codigo);

        ProductoSeleccionadoVincularId = string.Empty;
        EditNombre = !string.IsNullOrEmpty(nombreWeb) ? nombreWeb : "";
        EditMarca = marcaWeb;
        EditCategoriaId = string.Empty;
        EditPrecioReal = 0m;
        EditCantidad = 1;
        
        buscandoEnWeb = false;
        StateHasChanged();
    }

    private async Task<(string Nombre, string Marca)> ConsultarAPIsWebAsync(string codigo)
    {
        string[] dominios = new[] {
            "world.openfoodfacts.org",
            "world.openproductsfacts.org",
            "world.openbeautyfacts.org"
        };

        foreach (var dominio in dominios)
        {
            try
            {
                var response = await Http.GetStringAsync($"https://{dominio}/api/v0/product/{codigo}.json");
                using var doc = JsonDocument.Parse(response);
                var root = doc.RootElement;

                if (root.TryGetProperty("status", out var st) && st.GetInt32() == 1)
                {
                    var prod = root.GetProperty("product");

                    // Nombre (busca español primero, luego general)
                    string nombre = "";
                    if (prod.TryGetProperty("product_name_es", out var nEs) && !string.IsNullOrWhiteSpace(nEs.GetString()))
                        nombre = nEs.GetString()!;
                    else if (prod.TryGetProperty("product_name", out var n) && !string.IsNullOrWhiteSpace(n.GetString()))
                        nombre = n.GetString()!;

                    // Marca (busca marcas o propietario de la marca)
                    string marca = "";
                    if (prod.TryGetProperty("brands", out var b) && !string.IsNullOrWhiteSpace(b.GetString()))
                        marca = b.GetString()!;
                    else if (prod.TryGetProperty("brand_owner", out var bo) && !string.IsNullOrWhiteSpace(bo.GetString()))
                        marca = bo.GetString()!;

                    if (!string.IsNullOrEmpty(nombre) || !string.IsNullOrEmpty(marca))
                    {
                        return (nombre, marca);
                    }
                }
            }
            catch { }
        }

        return (string.Empty, string.Empty);
    }

    private async Task ConfirmarAgregarAlCarrito()
    {
        if (itemSeleccionado != null)
        {
            itemSeleccionado.CantidadPlaneada = cantidadAComprar;
            itemSeleccionado.PrecioEstimado = precioTemporal;
            itemSeleccionado.Comprado = true;

            await Storage.GuardarListaActualAsync(ItemsLista);
            CerrarModales();
        }
    }

